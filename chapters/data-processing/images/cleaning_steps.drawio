<mxfile host="app.diagrams.net"><diagram id="d" name="Page-1"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value='Raw text&lt;br&gt;&lt;span style="font-weight:normal;font-size:11px"&gt;Dr. Maria L. Okafor, VP Ops;&lt;br&gt;Prairie Wind Energy Inc; ...&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#7d8597;fontColor=#ffffff;fontSize=14;strokeColor=#7d8597;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="40" width="190" height="90" as="geometry"/></mxCell><mxCell id="v2" value='1. Parsing&lt;br&gt;&lt;span style="font-weight:normal;font-size:11px"&gt;separate the elements:&lt;br&gt;title, names, job, company, address&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#2b7bd6;fontColor=#ffffff;fontSize=14;strokeColor=#2b7bd6;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="40" width="190" height="90" as="geometry"/></mxCell><mxCell id="v3" value='2. Correction&lt;br&gt;&lt;span style="font-weight:normal;font-size:11px"&gt;fix wrong or missing values:&lt;br&gt;add postal code 66044&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#2a9d8f;fontColor=#ffffff;fontSize=14;strokeColor=#2a9d8f;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="40" width="190" height="90" as="geometry"/></mxCell><mxCell id="v4" value='3. Standardization&lt;br&gt;&lt;span style="font-weight:normal;font-size:11px"&gt;preferred formats:&lt;br&gt;VP Ops &amp;#8594; Vice President, Operations&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#6aaa64;fontColor=#ffffff;fontSize=14;strokeColor=#6aaa64;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="720" y="40" width="190" height="90" as="geometry"/></mxCell><mxCell id="v5" value='Clean record&lt;br&gt;&lt;span style="font-weight:normal;font-size:11px"&gt;ready to count, join&lt;br&gt;and group&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#14365d;fontColor=#ffffff;fontSize=14;strokeColor=#14365d;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="960" y="40" width="170" height="90" as="geometry"/></mxCell><mxCell id="e6" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="v1" target="v2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="v2" target="v3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="v3" target="v4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="v4" target="v5"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>